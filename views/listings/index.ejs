<% layout('/layouts/boilerplate')%>

<div id="filters">
  <div class="filter-container">
    <a href="/listings<%= search ? '?search=' + encodeURIComponent(search) : '' %>" class="filter <%= !category ? 'active' : '' %>">
      <div><i class="fa-solid fa-compass"></i></div>
      <div>All</div>
    </a>
    
    <% 
      const categories = [
        { name: "Trending", icon: "fa-fire" },
        { name: "Rooms", icon: "fa-bed" },
        { name: "Iconic cities", icon: "fa-mountain-city" },
        { name: "Mountain", icon: "fa-mountain" },
        { name: "Castles", icon: "fa-fort-awesome" },
        { name: "Amazing pools", icon: "fa-person-swimming" },
        { name: "Camping", icon: "fa-campground" },
        { name: "Farms", icon: "fa-cow" },
        { name: "Arctic", icon: "fa-snowflake" }
      ];
    %>

    <% for (let cat of categories) { %>
      <% 
        let queryParams = [];
        queryParams.push("category=" + encodeURIComponent(cat.name));
        if (search) queryParams.push("search=" + encodeURIComponent(search));
        let href = "/listings?" + queryParams.join("&");
      %>
      <a href="<%= href %>" class="filter <%= category === cat.name ? 'active' : '' %>">
        <div><i class="fa-solid <%= cat.icon %>"></i></div>
        <div><%= cat.name %></div>
      </a>
    <% } %>
  </div>

  <div class="tax-toggle">
    <div class="form-check form-switch form-check-reverse">
      <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>

<% if (search || category) { %>
  <p class="mt-2 text-muted">
    Showing results 
    <% if (category) { %> for category: <strong>"<%= category %>"</strong> <% } %>
    <% if (search) { %> matching <strong>"<%= search %>"</strong> <% } %>
    &nbsp;<a href="/listings" class="text-danger" style="font-size:0.85rem;">Clear all filters</a>
  </p>
<% } %>

<% if (allListing.length === 0) { %>
  <div class="text-center mt-5">
    <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>
    <h4 class="text-muted">No listings found</h4>
    <p>Try selecting another category or clear filters. <a href="/listings">View all listings</a></p>
  </div>
<% } else { %>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListing){ %>
  <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class="card col listing-card">
      <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image" style="height: 20rem;">
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
          <b><%=listing.title%></b><br>
          &#8377;<%=listing.price.toLocaleString('en-IN')%> / night
          <i class="tax-info"> &nbsp;+18% GST</i>
        </p>
      </div>
    </div>
  </a>
  <%}%>
</div>
<% } %>

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");
  if (taxSwitch) {
    taxSwitch.addEventListener("click", () => {
      let taxInfo = document.getElementsByClassName("tax-info");
      for (let info of taxInfo) {
        if (info.style.display !== "inline") {
          info.style.display = "inline";
        } else {
          info.style.display = "none";
        }
      }
    });
  }
</script>